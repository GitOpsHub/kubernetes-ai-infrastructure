{
  "title": "GPU Fleet (DCGM)",
  "uid": "ch04-gpu-fleet",
  "tags": ["gpu", "dcgm", "course-chapter-04"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "Hostname",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, Hostname)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU Utilization %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL{Hostname=~\"$Hostname\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Framebuffer Memory Used vs Free",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{Hostname=~\"$Hostname\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}} used"
        },
        {
          "expr": "DCGM_FI_DEV_FB_FREE{Hostname=~\"$Hostname\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}} free"
        }
      ]
    },
    {
      "id": 3,
      "title": "Power Usage (W)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "watt" }, "overrides": [] },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_POWER_USAGE{Hostname=~\"$Hostname\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "GPU Temperature (C)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP{Hostname=~\"$Hostname\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}"
        }
      ],
      "thresholds": { "steps": [ { "value": 85, "color": "red" } ] }
    },
    {
      "id": 5,
      "title": "SM Clock (MHz)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK{Hostname=~\"$Hostname\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "XID Errors (5m increase)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "increase(DCGM_FI_DEV_XID_ERRORS[5m])",
          "legendFormat": "{{Hostname}} gpu{{gpu}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "GPUs Allocatable vs Allocated (from kube-state-metrics)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "kube_node_status_allocatable{resource=\"nvidia_com_gpu\"}",
          "legendFormat": "allocatable {{node}}"
        },
        {
          "expr": "sum(kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"}) by (node)",
          "legendFormat": "requested {{node}}"
        }
      ]
    }
  ]
}
