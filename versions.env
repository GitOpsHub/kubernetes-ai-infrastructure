# Pinned versions used across all chapters (verified against upstream releases on 2026-09-16).
# Source this file:  source versions.env
# Bump deliberately; each chapter README lists the versions it was written against.

# --- NVIDIA ---
export GPU_OPERATOR_VERSION="v26.7.0"          # helm: nvidia/gpu-operator
export DEVICE_PLUGIN_VERSION="v0.20.0"         # NVIDIA/k8s-device-plugin
export DCGM_EXPORTER_CHART_VERSION="4.8.3"     # helm: gpu-helm-charts/dcgm-exporter

# --- Observability / autoscaling ---
export KUBE_PROMETHEUS_STACK_VERSION="91.4.1"  # helm: prometheus-community/kube-prometheus-stack
export PROMETHEUS_ADAPTER_VERSION="5.3.0"      # helm: prometheus-community/prometheus-adapter
export KEDA_VERSION="2.20.2"                   # helm: kedacore/keda

# --- Scheduling / batch / training ---
export KUEUE_VERSION="0.19.4"                  # helm: oci://registry.k8s.io/kueue/charts/kueue
export VOLCANO_VERSION="v1.15.2"
export KUBEFLOW_TRAINER_VERSION="v2.3.0"
export KUBERAY_VERSION="1.7.0"                 # helm: kuberay/kuberay-operator
export LWS_VERSION="v0.10.0"                   # LeaderWorkerSet

# --- Serving ---
export VLLM_VERSION="v0.29.0"                  # image: vllm/vllm-openai
export OLLAMA_VERSION="0.34.1"                 # CPU-friendly serving for no-GPU labs
export KSERVE_VERSION="v0.20.0"
export GATEWAY_API_VERSION="v1.6.2"
export GAIE_VERSION="v1.6.1"                   # Gateway API Inference Extension

# --- Node autoscaling ---
export KARPENTER_VERSION="1.14.1"              # EKS only
