# Copy to env.sh (gitignored) and fill in:  cp env.sh.example env.sh && source env.sh

# ---------- EKS ----------
export AWS_REGION="us-east-1"
export EKS_CLUSTER="eks-ai-lab"
export AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"

# ---------- Common ----------
export HF_TOKEN=""   # Hugging Face token for gated models (never commit)
