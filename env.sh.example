# Copy to env.sh (gitignored) and fill in:  cp env.sh.example env.sh && source env.sh

# ---------- GKE ----------
export PROJECT_ID="my-gcp-project"
export REGION="us-east1"
export ZONE="us-east1-b"
export GKE_CLUSTER="gke-ai-lab"

# ---------- EKS ----------
export AWS_REGION="us-east-1"
export EKS_CLUSTER="eks-ai-lab"
export AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"

# ---------- AKS ----------
export AZ_SUBSCRIPTION_ID="$(az account show --query id -o tsv 2>/dev/null)"
export AZ_RESOURCE_GROUP="rg-aks-ai-lab"
export AZ_LOCATION="eastus"
export AKS_CLUSTER="aks-ai-lab"

# ---------- Common ----------
export HF_TOKEN=""   # Hugging Face token for gated models (never commit)
