# Copy to env.sh (gitignored) and fill in before running any command:
#   cp env.sh.example env.sh && source env.sh && source versions.env
#
# env.sh is sourced alongside versions.env in every chapter lab. Keep both files sourced
# in every shell session where you run chapter commands.

# ---------- EKS ----------
export AWS_REGION="us-east-1"
export EKS_CLUSTER="eks-ai-lab"

# Auto-populated at source time if the aws CLI is authenticated (aws configure / aws configure sso).
# You can also set it explicitly: export AWS_ACCOUNT_ID="123456789012"
export AWS_ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"

# ---------- Cost guardrails ----------
# Monthly budget ceiling in USD -- used in chapter 00 Step 3 to create an AWS Budget alert.
# Raise or lower to match what you are comfortable spending while running labs.
export BUDGET_USD="50"

# ---------- Common ----------
# Hugging Face token for gated models (e.g. Llama). Never commit this file with a real token.
export HF_TOKEN=""
