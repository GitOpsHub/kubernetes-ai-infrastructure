# cpu-lab pipeline parameters (replaces common/base/params.env entirely).
# SmolLM2-135M-Instruct: small enough to LoRA-fine-tune on a laptop CPU in minutes.
MODEL_ID=HuggingFaceTB/SmolLM2-135M-Instruct
MODEL_REVISION=12fd25f77366fa6b3b4b768ec3050bf629380bac
DATASET_ID=trl-lib/Capybara
DATASET_REVISION=e235e846458bff3398a88aed812347f7f0756520
MAX_STEPS=20
# Looser gate than the GPU run: a 135M model after 20 CPU steps is not going to be great.
MAX_EVAL_LOSS=3.5
SAVE_STEPS=10
LEARNING_RATE=2e-4
MAX_LENGTH=512
PER_DEVICE_BATCH=2
GRAD_ACCUM=2
LORA_R=8
TRAIN_SAMPLES=200
EVAL_SAMPLES=50
# Chapter 09 cpu-lab Ollama (OpenAI-compatible at /v1).
OPENAI_BASE_URL=http://ollama.ch09-vllm-cpu.svc.cluster.local:11434/v1
CHAT_MODEL=qwen3:0.6b
EMBEDDINGS_URL=http://tei.ch19-pipelines.svc.cluster.local:8080
# chat_template_kwargs is a vLLM extension; Ollama silently drops it, so qwen3:0.6b still THINKS.
# Checked against Ollama v0.34.1 (server/routes.go, openai/openai.go): thinking-capable models default
# to think=true, and /v1 returns the reasoning in a separate `reasoning` field, NOT as <think> in
# `content` (strip_think is then a no-op). Only `reasoning_effort: "none"` turns it off on Ollama.
# REASONING_EFFORT=none -> rag_chain.py sends reasoning_effort="none" (Ollama: think=false). Leave it
# unset for vLLM (common/base/params.env).
REASONING_EFFORT=none
DISABLE_THINKING=true
